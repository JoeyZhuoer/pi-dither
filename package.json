{
  "name": "@joeyzhuoer/pi-terminal-ui",
  "version": "0.2.0",
  "private": true,
  "description": "A retro windowed desktop and terminal presentation layer for core Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": ["./extensions/index.ts"],
    "themes": ["./themes/pi-terminal.json"]
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "desktop": "node desktop/server.mjs --open",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node --test tests/desktop.test.mjs",
    "test:terminal": "python3 tests/terminal-smoke.py"
  }
}
